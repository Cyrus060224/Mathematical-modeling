# ==========================================
# 1. 核心数据集 (最重要！防止上传 1.41GB 附件)
# ==========================================
data/
*.zip
*.rar
*.7z

# ==========================================
# 2. 运行结果与中间产物
# ==========================================
results/
*.csv
*.xlsx
*.png
*.jpg
*.jpeg

# ==========================================
# 3. Python 环境与缓存
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.pytest_cache/

# ==========================================
# 4. 编辑器与操作系统垃圾 (兼容你的 Mac 和 Windows)
# ==========================================
# Mac 系统文件
.DS_Store
.AppleDouble
.LSOverride

# Windows 系统文件
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code 配置
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ==========================================
# 5. 论文暂存与日志
# ==========================================
docs/**/*.log
docs/**/*.aux
docs/**/*.out